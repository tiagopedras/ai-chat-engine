{
  "name": "@tiagopedras/ai-chat-engine",
  "version": "0.5.0",
  "description": "A Claude Code chat window any local app can drop in, built from Tenon's components, plus the engines that run the CLI behind it. React, shipped both as a component and as a one-file bundle for pages with no build.",
  "license": "MIT",
  "type": "module",
  "main": "dist/react/index.js",
  "browser": "dist/ai-chat.js",
  "style": "dist/chat.css",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./ai-chat.js": "./dist/ai-chat.js",
    "./chat.css": "./dist/chat.css",
    "./chat.standalone.css": "./dist/chat.standalone.css",
    "./node": "./node/dist/index.js",
    "./package.json": "./package.json",
    "./cards.js": "./interface/cards.js"
  },
  "files": [
    "dist",
    "interface/cards.js",
    "interface/cards.d.ts",
    "node/dist",
    "engine.py",
    "http_glue.py",
    "README.md"
  ],
  "scripts": {
    "build:node": "tsc -p tsconfig.json",
    "build:react": "vite build",
    "build:bundle": "vite build --mode bundle",
    "build:types": "tsc -p tsconfig.react.json",
    "build:css": "node scripts/standalone-css.mjs",
    "build": "npm run build:node && npm run build:react && npm run build:bundle && npm run build:types && npm run build:css",
    "check": "tsc --noEmit -p tsconfig.react.json",
    "prepublishOnly": "npm run build",
    "test": "node test/chat.test.mjs"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3",
    "@tiagopedras/tenon": ">=0.7.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiagopedras/ai-chat-engine.git"
  },
  "homepage": "https://github.com/tiagopedras/ai-chat-engine#readme",
  "bugs": {
    "url": "https://github.com/tiagopedras/ai-chat-engine/issues"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@tiagopedras/tenon": "github:tiagopedras/tenon#v0.7.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "types": "dist/types/index.d.ts",
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@tiagopedras/tenon": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "thinking-orbs": "^0.3.2"
  }
}
