{
  "name": "@tiagopedras/ai-chat-engine",
  "version": "0.3.0",
  "description": "A Claude Code chat modal any local app can drop in, plus the Python engine that runs the CLI behind it. Vanilla JS/CSS, no build step, no dependency.",
  "license": "UNLICENSED",
  "private": true,
  "main": "interface/chat.js",
  "browser": "interface/chat.js",
  "style": "interface/chat.css",
  "exports": {
    ".": "./interface/chat.js",
    "./chat.js": "./interface/chat.js",
    "./chat.css": "./interface/chat.css",
    "./node": "./node/dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "interface/chat.js",
    "interface/chat.css",
    "node/dist",
    "engine.py",
    "http_glue.py",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiagopedras/ai-chat-engine.git"
  },
  "homepage": "https://github.com/tiagopedras/ai-chat-engine#readme",
  "bugs": {
    "url": "https://github.com/tiagopedras/ai-chat-engine/issues"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
